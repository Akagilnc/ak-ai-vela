DATABASE_URL="file:./prisma/dev.db"

# Cloudflare quick-tunnel host for Next.js dev server (optional, dev-only).
# Update this whenever `cloudflared` hands you a new hostname — no source
# commit required. Accepts a single origin or a comma-separated list.
# Example: DEV_TUNNEL_ORIGIN="premises-legitimate-anchor-seek.trycloudflare.com"
DEV_TUNNEL_ORIGIN=""

# HMAC secret for the studentId cookie set by /questionnaire submit.
# Required in production (server refuses to boot without it). In dev/test
# a banner-warned fallback is used so local dev works without setup.
# Generate with: `openssl rand -hex 32`
# Must be ≥ 32 chars.
STUDENT_TOKEN_SECRET=""
